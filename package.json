{
  "name": "cricket-then-now-always",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test legacy/tests/*.test.mjs && vitest run",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "biome check --write .",
    "capture": "node tools/capture/capture.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.19.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
